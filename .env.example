# PlantBrain environment configuration

# Enable read-only mode for a public portfolio demo.
# Local development: false
# Public deployment: true
PLANTBRAIN_DEMO_MODE=false

# URL of the deployed frontend.
# Leave empty for local development.
# Example:
# PLANTBRAIN_FRONTEND_ORIGIN=https://plantbrain.example.com
PLANTBRAIN_FRONTEND_ORIGIN=
